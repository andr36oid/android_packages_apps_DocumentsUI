<!-- A bold outline marks the D-pad focus, a tinted fill marks the storage device that is
     currently open. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/quick_link_radius"/>
            <solid android:color="?android:attr/colorSecondary"/>
            <stroke
                android:width="@dimen/dpad_focus_stroke_width"
                android:color="?android:attr/colorPrimary"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/quick_link_radius"/>
            <stroke
                android:width="@dimen/dpad_focus_stroke_width"
                android:color="?android:attr/colorPrimary"/>
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/quick_link_radius"/>
            <solid android:color="?android:attr/colorSecondary"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/quick_link_radius"/>
            <stroke
                android:width="1dp"
                android:color="?android:attr/strokeColor"/>
        </shape>
    </item>
</selector>
