<!-- andr36oid: the controller buttons along the bottom, the launcher's look, as in Settings and
     the Quick start guide. The keys are handled by BaseActivity/FilesActivity. On
     the left: how many items are selected. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/andr36oid_hint_bar"
    android:layout_width="match_parent"
    android:layout_height="24dp"
    android:background="?android:attr/colorBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <TextView
        android:id="@+id/andr36oid_hint_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#e6e6e6" />
    <TextView
        style="@style/Andr36oidHintKey"
        android:text="A" />
    <TextView
        style="@style/Andr36oidHintLabel"
        android:text="@string/andr36oid_hint_open" />
    <TextView
        style="@style/Andr36oidHintKey"
        android:text="B" />
    <TextView
        style="@style/Andr36oidHintLabel"
        android:text="@string/andr36oid_hint_back" />
    <TextView
        android:id="@+id/andr36oid_hint_menu_key"
        style="@style/Andr36oidHintKey"
        android:text="X" />
    <TextView
        android:id="@+id/andr36oid_hint_menu"
        style="@style/Andr36oidHintLabel"
        android:text="@string/andr36oid_hint_menu" />
    <TextView
        style="@style/Andr36oidHintKey"
        android:text="Y" />
    <TextView
        style="@style/Andr36oidHintLabel"
        android:text="@string/andr36oid_hint_search" />
    <TextView
        android:id="@+id/andr36oid_hint_storage_key"
        style="@style/Andr36oidHintKey"
        android:text="L1 R1" />
    <TextView
        android:id="@+id/andr36oid_hint_storage"
        style="@style/Andr36oidHintLabel"
        android:text="@string/andr36oid_hint_storage" />
</LinearLayout>
